# Copy to .env and fill in your own values. Never commit .env.

# Language model provider: gemini | groq
LLM_PROVIDER=groq

# Groq (used when LLM_PROVIDER=groq). Install with: pip install -e ".[groq]"
GROQ_API_KEY=your_groq_api_key_here
# Run `repomind models` to see which models your key can use, then pick one.
GROQ_MODEL=

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: override the model for whichever provider is active
# LLM_MODEL=

# Comma-separated fallback models for the active provider, tried when the main model stays busy
LLM_FALLBACK_MODELS=
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.5

# Access tokens for private repositories (optional, used for github.com / gitlab.com)
GITHUB_TOKEN=
GITLAB_TOKEN=

# Retrieval: hybrid | selective | fused  (see README)
RETRIEVAL_MODE=selective
USE_QUERY_EXPANSION=true
# Set to false to save one Gemini call per answer
GROUNDING_CHECK=true

# Indexing limits (raise these for very large repositories)
REPOMIND_MAX_FILES=5000
REPOMIND_MAX_FILE_BYTES=300000
REPOMIND_MAX_TOTAL_BYTES=30000000
REPOMIND_MAX_CHUNKS=40000
REPOMIND_CLONE_TIMEOUT=300

# Where the index and registry live (defaults to ./data in a source checkout)
# REPOMIND_DATA_DIR=./data
